# Doit correspondre aux identifiants du docker-compose.yml pour le dev local.
DATABASE_URL="postgresql://las:las_dev_password@localhost:5432/las_inspections?schema=public"

PORT=4000

# FRONTEND_ORIGIN="http://localhost:5173"
FRONTEND_ORIGIN="http://localhost:8080"

# Secret de signature des sessions (JWT en cookie httpOnly). À générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-generate-a-real-secret"

# Durée de session, en secondes (doit rester cohérent avec SESSION_TTL_SECONDS
# côté frontend, src/lib/auth-api.ts).
SESSION_TTL_SECONDS=28800

# Nom du cookie de session.
SESSION_COOKIE_NAME="las_session"

# Stockage des photos — "local" pour l'instant (sprint suivant : S3/R2).
PHOTO_STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
# URL publique sous laquelle /uploads est servi (adapter en prod).
PUBLIC_UPLOAD_BASE_URL="http://localhost:4000/uploads"

# Mot de passe des comptes de démonstration créés par prisma/seed.ts —
# à changer/désactiver avant toute mise en production réelle.
DEMO_SEED_PASSWORD="ChangeMe123!"
