generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  supervisor
}

enum TaskStatus {
  not_submitted
  in_progress
  pending // "En attente de vérification"
  verified
}

enum TaskKind {
  horizontal
  batiment
}

/// Compte utilisateur — voir src/lib/user-directory.ts côté frontend.
model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         Role     @default(supervisor)
  /// Groupes de supervision (ex. "Supervisor 1") — un utilisateur peut en avoir plusieurs.
  groups       String[]
  initials     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions Submission[]
  tasksCreated Task[]      @relation("TaskCreatedBy")

  @@map("users")
}

/// Tâche d'inspection assignée — voir src/lib/mock-data.ts#TaskRow côté frontend.
model Task {
  id        String     @id @default(cuid())
  form      String
  dueDate   DateTime
  zone      String
  notes     String      @default("")
  group     String
  /// Dénormalisés pour retrouver exactement les filtres front (année/bimestre/semaine)
  /// sans recalcul ambigu côté client.
  year      Int
  bimester  Int
  week      Int
  status    TaskStatus @default(not_submitted)
  kind      TaskKind   @default(horizontal)

  createdById String?
  createdBy   User?    @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  submissions Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group, status])
  @@index([form])
  @@map("tasks")
}

/// Fiche soumise — en-tête + liste de constats en JSON (structure proche de
/// PointState côté frontend). Les photos sont stockées séparément (table Photo)
/// pour garantir des URLs stables (sprint "stockage objets fiable").
model Submission {
  id     String   @id @default(cuid())
  task   Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String
  kind   TaskKind

  form    String
  zone    String
  notes   String @default("")
  group   String

  /// Uniquement pour les fiches bâtiment.
  sector     String?
  compliance String?

  comment String @default("")

  /// Liste des constats en défaut : { segment?, category, point, severity,
  /// qualitatif, localisation, actionCorrective, photoIds: string[] }[]
  defects Json

  /// Numéro(s) de version des dictionnaires en vigueur à la soumission —
  /// traçabilité "une fiche déjà soumise n'est pas altérée rétroactivement".
  modelVersion Json

  submittedBy   User     @relation(fields: [submittedById], references: [id])
  submittedById String
  submittedAt   DateTime @default(now())
  idempotencyKey String? @unique
  
  photos Photo[]

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([submittedAt])
  @@map("submissions")
}

/// Photo attachée à un constat — fichier stocké (disque pour l'instant,
/// S3/R2 prévu) + URL stable et servie publiquement.
model Photo {
  id            String     @id @default(cuid())
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId  String
  /// Identifie à quel point/item de la fiche cette photo appartient (id de constat).
  constatKey    String
  /// Chemin relatif sur le disque (ou clé objet une fois migré vers S3/R2).
  storageKey    String
  /// URL publique stable — jamais de localhost codé en dur côté client.
  url           String
  mimeType      String
  sizeBytes     Int
  createdAt     DateTime   @default(now())

  @@index([submissionId])
  @@map("photos")
}

/// Dictionnaire versionné (familles/dégradations, catalogue de fiches, checklist
/// bâtiment) — même principe que src/lib/dictionary-store.ts côté frontend :
/// une ligne par clé, données en JSON, version incrémentée à chaque écriture.

model DictionaryEntry {
  id        String   @id @default(cuid())
  key       String
  data      Json
  version   Int
  createdAt DateTime @default(now())

  @@unique([key, version])
  @@index([key])
  @@map("dictionary_entries")
}
