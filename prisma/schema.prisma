generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  supervisor
}

enum TaskStatus {
  not_submitted
  in_progress
  pending // "En attente de vérification"
  verified
}

enum TaskKind {
  horizontal
  batiment
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         Role     @default(supervisor)
  groups       String[]
  initials     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions Submission[]
  tasksCreated Task[]      @relation("TaskCreatedBy")
  sessions     Session[]

  @@map("users")
}


model Session {
  id        String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Task {
  id        String     @id @default(cuid())
  form      String
  dueDate   DateTime
  zone      String
  notes     String      @default("")
  group     String

  year      Int
  bimester  Int
  week      Int
  status    TaskStatus @default(not_submitted)
  kind      TaskKind   @default(horizontal)

  createdById String?
  createdBy   User?    @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  submissions Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group, status])
  @@index([form])
  @@map("tasks")
}

model Submission {
  id     String   @id @default(cuid())
  task   Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String
  kind   TaskKind

  form    String
  zone    String
  notes   String @default("")
  group   String

  sector     String?
  compliance String?

  comment String @default("")

  defects Json

  modelVersion Json

  submittedBy   User     @relation(fields: [submittedById], references: [id])
  submittedById String
  submittedAt   DateTime @default(now())
  idempotencyKey String? @unique
  
  photos Photo[]

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([submittedAt])
  @@map("submissions")
}

model Photo {
  id            String     @id @default(cuid())
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId  String
  constatKey    String
  storageKey    String
  url           String
  mimeType      String
  sizeBytes     Int
  createdAt     DateTime   @default(now())

  @@index([submissionId])
  @@map("photos")
}


model DictionaryEntry {
  id        String   @id @default(cuid())
  key       String
  data      Json
  version   Int
  createdAt DateTime @default(now())

  @@unique([key, version])
  @@index([key])
  @@map("dictionary_entries")
}
