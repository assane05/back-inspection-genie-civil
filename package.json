{
  "name": "las-inspections-api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "seed:admin": "tsx prisma/seed-admin.ts",
    "seed:runway": "tsx prisma/seed-runway.ts",
    "seed:apron": "tsx prisma/seed-apron.ts",
    "seed:chemin-ronde": "tsx prisma/seed-chemin-ronde.ts",
    "seed:fence-ouvrage-service": "tsx prisma/seed-fence-ouvrage-service.ts",
    "seed:taxiway-parking": "tsx prisma/seed-taxiway-parking.ts",
    "seed:fiches": "npm run seed:runway && npm run seed:apron && npm run seed:chemin-ronde && npm run seed:fence-ouvrage-service && npm run seed:taxiway-parking",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@prisma/client": "^6.1.0",
    "argon2": "^0.45.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.1.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.12.0": true,
    "argon2@0.45.1": true,
    "esbuild@0.28.1": true,
    "prisma@6.12.0": true
  }
}
